# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_manager

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_MAX=100
